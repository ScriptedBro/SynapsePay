# ==========================================
# SynapsePay Production Environment Config
# ==========================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
API_KEY=synapse_live_sec_prod_key_change_me
BASE_URL=http://localhost:3000

# PayPal Developer Credentials (Sandbox or Production)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# PayPal Escrow Settlement Settings
PAYPAL_ESCROW_HOLD_CURRENCY=USD
MAX_ESCROW_AMOUNT_USD=5000.00
DEFAULT_CONTRACT_TIMEOUT_SECONDS=86400

# Autonomous AI Arbitrator Engine
OPENAI_API_KEY=your_openai_api_key_here
ARBITRATION_MODEL=gpt-4o
ARBITRATION_MIN_PASS_SCORE=85

# Security & Audit Trail
AUDIT_HMAC_SECRET=your_sha256_audit_hmac_secret_here
ENABLE_SANDBOX_ISOLATION=true
